rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 🛡️ ATURAN KEAMANAN DATABASE HOMECAREKU (FIRESTORE SECURITY RULES)
    // =========================================================================
    // 1. Publik (Web Pengunjung):
    //    HANYA DIIZINKAN MEMBACA (read: get, list).
    //    Semua pengunjung web dapat melihat layanan, testimoni, profil, dan kontak klinik.
    //
    // 2. Akses Tulis / Ubah / Hapus (write: create, update, delete):
    //    HANYA DIIZINKAN jika pengguna sudah login / terautentikasi (request.auth != null).
    //    Pihak asing atau hacker yang mencoba mengirim skrip setDoc dari browser
    //    akan langsung DITOLAK TOTAL oleh server Google Cloud (PERMISSION_DENIED).
    // =========================================================================

    match /content/{document} {
      // Izinkan publik membaca konten klinik
      allow read: if true;

      // Hanya izinkan admin yang terautentikasi untuk menyimpan/mengubah konten
      allow write: if request.auth != null;
    }

    // Blokir semua akses ke dokumen lain di luar koleksi 'content'
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
